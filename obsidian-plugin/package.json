{
  "name": "obsidian-supabase-sync",
  "version": "1.0.0",
  "description": "Bidirectional sync between Obsidian vault and Supabase RAG database",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "supabase", "rag", "sync"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0"
  }
}
